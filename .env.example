# Copy this file to .env. Never commit real credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
GOOGLE_API_KEY=google_apk-key

# Models and RAG settings
CHAT_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=models/gemini-embedding-001
STT_MODEL=gemini-3.5-transcribe-live
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Zephyr
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.25
COMPANY_NAME=ECHO EMAAR TRADING COMPANY
